// Hand-maintained definitions appended by extract-files.py.

android_app_import {
    name: "OnePlusCamera",
    owner: "oneplus",
    apk: "proprietary/product/priv-app/OnePlusCamera/OnePlusCamera.apk",
    presigned: true,
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    overrides: ["Aperture"],
    product_specific: true,
}

cc_prebuilt_library_shared {
    name: "libaudiohal@6.0",
    owner: "oneplus",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: [
                "proprietary/system/lib/libaudiohal@6.0.so",
            ],
        },
        android_arm64: {
            srcs: [
                "proprietary/system/lib64/libaudiohal@6.0.so",
            ],
        },
    },
    compile_multilib: "both",
    check_elf_files: false,
    shared_libs: [
        "android.hardware.audio.common@6.0",
        "android.hardware.audio.common@6.0-util",
        "android.hardware.audio.effect@6.0",
        "android.hardware.audio.effect@6.0-util",
        "android.hardware.audio@6.0",
        "android.hardware.audio@6.0-util",
    ],
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "prebuilt_libCameraMDMHelper@2.0",
