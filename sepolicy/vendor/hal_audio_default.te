dontaudit hal_audio_default default_prop:file r_file_perms;
dontaudit hal_audio_default vendor_diag_device:chr_file rw_file_perms;

# DTS:X Ultra
get_prop(hal_audio_default, vendor_dts_prop)
allow hal_audio_default dts_data_file:dir rw_dir_perms;
allow hal_audio_default dts_data_file:file create_file_perms;
allow hal_audio_default vendor_configs_file:file { ioctl lock };