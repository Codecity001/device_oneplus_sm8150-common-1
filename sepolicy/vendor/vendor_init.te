# ActivityManager background-service
set_prop(vendor_init, vendor_bservice_prop)

# Bluetooth
set_prop(vendor_init, exported_bluetooth_prop)

# DTS:X Ultra
allow vendor_init dts_data_file:dir create_dir_perms;
set_prop(vendor_init, vendor_dts_prop)

# Memplus
set_prop(vendor_init, vendor_system_prop)

# Memory
allow vendor_init proc_extra_free_kbytes:file { open write };
allow vendor_init proc_watermark_scale_factor:file { open write };

# proc/cmdline
allow vendor_init proc_cmdline:file getattr;

# Sensors
set_prop(vendor_init, vendor_sensors_als_prop)
