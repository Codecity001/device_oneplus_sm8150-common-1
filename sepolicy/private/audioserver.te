# DTS:X Ultra
typeattribute audioserver data_between_core_and_vendor_violators;
r_dir_file(audioserver, vendor_configs_file)
allow audioserver dts_data_file:dir rw_dir_perms;
allow audioserver dts_data_file:file create_file_perms;

# Umbra
allow audioserver umbra_data_file:dir r_dir_perms;
allow audioserver umbra_data_file:file r_file_perms;
